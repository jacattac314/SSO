# Server
NODE_ENV=development
PORT=3000
BASE_URL=https://sso.legora.com

# Database
DATABASE_URL=postgresql://legora:password@localhost:5432/legora_sso
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis (session store)
REDIS_URL=redis://localhost:6379
SESSION_SECRET=change-me-in-production-minimum-32-chars

# JWT
JWT_SECRET=change-me-in-production-minimum-32-chars
JWT_ISSUER=https://sso.legora.com
JWT_ACCESS_TOKEN_TTL=3600       # 1 hour in seconds
JWT_REFRESH_TOKEN_TTL=7776000   # 90 days in seconds

# Session timeouts (seconds)
SESSION_IDLE_TIMEOUT=900        # 15 minutes
SESSION_ABSOLUTE_TIMEOUT=28800  # 8 hours

# SAML SP defaults
SAML_SP_ENTITY_ID=https://sso.legora.com/saml/metadata
SAML_SP_ACS_URL=https://sso.legora.com/auth/saml/acs
SAML_SP_SLO_URL=https://sso.legora.com/auth/saml/slo
SAML_SP_CERT_FILE=./certs/sp.crt
SAML_SP_KEY_FILE=./certs/sp.key

# SCIM
SCIM_BASE_URL=https://sso.legora.com/scim/v2
SCIM_BEARER_SECRET=change-me-scim-bearer-token

# Certificate alerts (days before expiry to warn)
CERT_EXPIRY_WARN_DAYS=30

# Encryption key for tenant secrets at rest (AES-256 key, hex encoded)
TENANT_SECRET_ENCRYPTION_KEY=change-me-64-char-hex-string-for-aes256-encryption-here-xxxx

# Audit log retention (days)
AUDIT_LOG_RETENTION_DAYS=365

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS allowed origins (comma separated)
CORS_ALLOWED_ORIGINS=https://app.legora.com,https://admin.legora.com
